# Copy to .env.local and fill in what you want to enable.
# Anything left blank is simply hidden from the site.

# Public site URL (used for metadata, sitemap, and social previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Public contact details (shown on the site when set)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Contact form. Set to "true" only after the server-side values below are configured.
NEXT_PUBLIC_CONTACT_FORM=false

# Server-side only (never exposed to the browser). Uses the Resend email API.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
